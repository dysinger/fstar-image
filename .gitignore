# macOS
.DS_Store

# nix build results (result symlinks)
result
result-*

# Makefile build output (check/krml/demo all write under out/)
out/

# KaRaMeL wasm output dir (fstar-example-wasm uses `-tmpdir wasm-out`)
wasm-out/

# F* `.checked` cache, in case `fstar.exe` is run by hand without `--odir`.
# (The Makefile and default.nix both pass `--odir`, which routes these into
# out/ or the nix store — but a bare `fstar.exe` run drops them in cwd.)
*.checked
*.krml

# C compiler artifacts, in case `make` or a hand-run compile drops them in cwd.
*.o

# KaRaMeL wasm/web loader bundle, in case `krml -backend wasm` is run by hand
# without `-tmpdir` (the fstar-example-wasm derivation routes these into wasm-out/).
# The extensionless README loader file is ignored ONLY under wasm-out/.
wasm-out/README
wasm-out/loader.js
wasm-out/main.js
wasm-out/shell.js
wasm-out/browser.js
wasm-out/main.html
wasm-out/layouts.json
*.wasm
*.wast
